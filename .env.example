# CostureiraPro — variáveis públicas do app (sem segredos). Copie para .env.local se for rodar localmente.
# Hub único: planilhaprofissional-hub (cqirovvxtyreuvucosol)
VITE_SUPABASE_URL=https://cqirovvxtyreuvucosol.supabase.co
VITE_SUPABASE_ANON_KEY=
# Checkout Hotmart (deixe vazio até criar o produto: o botão Comprar abre o WhatsApp de interesse)
VITE_HOTMART_URL=
# Vídeos (opcionais)
VITE_YOUTUBE_COMECE_AQUI=
VITE_YOUTUBE_LANDING=

# Secrets da Edge (NUNCA aqui, nem com VITE_): cadastrar no painel do Supabase → Edge Functions → Secrets
# COSTUREIRAPRO_RESEND_API_KEY · COSTUREIRAPRO_RESEND_FROM_EMAIL · COSTUREIRAPRO_RESEND_FROM_NAME
# COSTUREIRAPRO_TOTP_KEY (32 bytes em base64) · COSTUREIRAPRO_HOTMART_HOTTOK · COSTUREIRAPRO_HOTMART_PRODUCT_IDS
